# Copy to .env and edit. NEVER commit the real .env file.
APP_NAME="Find a Skilled Worker Ghana"
ENVIRONMENT=development            # use "production" on a live server (enables strict safety checks)

# PostgreSQL. If your password has @ / # : ? use %40 %2F %23 %3A %3F instead.
DATABASE_URL=postgresql+psycopg2://skilled_user:change_me@localhost:5432/find_skilled_worker

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Website address(es) allowed to call the API. In production these MUST be https://
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where customers are sent back to after paying (production: https://your-domain)
FRONTEND_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ------------------------------------------------------------------ payments
# Leave PAYSTACK_SECRET_KEY blank and online payments stay OFF: nothing can be bought and
# nothing is ever marked as paid. Use an sk_test_... key first, sk_live_... only when you go live.


# Prices in Ghana cedis. EXAMPLE VALUES: set your own. A price of 0 means "not for sale".
PREMIUM_PRICE_MONTHLY_GHS=50
PREMIUM_PRICE_YEARLY_GHS=500
VERIFICATION_FEE_GHS=0            # 0 = verification is free
SPONSORED_PRICE_7D_GHS=40
SPONSORED_PRICE_30D_GHS=120

# API documentation pages (/docs). Default: on in development, off in production.
# ENABLE_API_DOCS=true
