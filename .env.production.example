# Copy to ".env" next to docker-compose.yml. NEVER commit the real file.

# Your website address, with no https:// and no slash. Its DNS "A" record must point at your server.
DOMAIN=www.example.com

# Choose a strong database password (letters and numbers are safest)
DB_PASSWORD=change-me-to-a-long-random-password

# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters

# Leave empty to keep online payments OFF. Paste sk_test_... to test, sk_live_... only when you go live.
PAYSTACK_SECRET_KEY=

# Prices in Ghana cedis (examples: set your own). 0 = not for sale / free
PREMIUM_PRICE_MONTHLY_GHS=50
PREMIUM_PRICE_YEARLY_GHS=500
VERIFICATION_FEE_GHS=0
SPONSORED_PRICE_7D_GHS=40
SPONSORED_PRICE_30D_GHS=120

# Shown in the website footer and Contact page (optional)
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WHATSAPP=
