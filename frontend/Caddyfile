{$DOMAIN} {
	encode gzip

	# API and uploaded photos go to the backend container
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /uploads/* {
		reverse_proxy backend:8000
	}

	# Everything else is the website; unknown paths fall back to index.html so page links work
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
